# Contenedor de prueba descartable (datos en memoria) para probar de punta a punta antes de desplegar.
# Se accede por un túnel desde TWO:  ssh -N -L 8094:192.168.100.142:8094 perse-phone@three.home.arpa
#   GM:       http://localhost:8094
#   Jugador:  los QR apuntan a http://127.0.0.1:8094 (otro host, así cada uno tiene su propia cookie)
APP_PUBLIC_BASE_URL=http://127.0.0.1:8094
APP_COOKIE_SECURE=false

# Clave del portal /admin de prueba (solo vale para este contenedor descartable)
APP_ADMIN_KEY=portal-admin-de-prueba-2026

# Contraseña de GM de la campaña de prueba (solo vale para este contenedor descartable)
E2E_CAMPAIGN_NAME=Prueba E2E
E2E_GM_PASSPHRASE=mesa-de-prueba-2026
